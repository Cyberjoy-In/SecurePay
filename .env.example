# Copy this file to .env for local development. Never commit .env.
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=securepay
JWT_SECRET=replace-with-a-long-random-secret
TELEGRAM_BOT_TOKEN=replace-with-a-new-rotated-bot-token
TELEGRAM_CHAT_ID=replace-with-your-telegram-chat-id
FINNHUB_API_KEY=replace-with-your-finnhub-api-key
