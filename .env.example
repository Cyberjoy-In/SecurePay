# Copy this file to .env for local development. Never commit .env.
# Use this when MongoDB is installed and running locally:
MONGODB_URI=mongodb://127.0.0.1:27017
# For MongoDB Atlas, use the URI from Atlas and URL-encode special characters in the password.
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=securepay
JWT_SECRET=replace-with-a-long-random-secret
TELEGRAM_BOT_TOKEN=replace-with-a-new-rotated-bot-token
TELEGRAM_CHAT_ID=replace-with-your-telegram-chat-id
FINNHUB_API_KEY=replace-with-your-finnhub-api-key
FD_MATURITY_WORKER_TOKEN=replace-with-a-long-random-worker-token
ADMIN_EMAIL=
TRUST_PROXY=false
# Optional JWT validation context. Configure the same values in the deployment environment and token issuer.
# JWT_ISSUER=
# JWT_AUDIENCE=
